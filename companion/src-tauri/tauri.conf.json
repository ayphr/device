{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ayphr Companion",
  "version": "0.1.0",
  "identifier": "com.ayphr.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ayphr Companion",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NUUwRTZEMTAwNjI4REEKUldUYUtBWVFiUTVlbEk3OEtuL2pZbmV5VTNkdnlTT0tkUEpFTUlNVU9MY2JkMWgvOWlaN1dvQTAK",
      "endpoints": [
        "https://github.com/ayphr/device/releases/latest/download/latest.json"
      ]
    }
  }
}
